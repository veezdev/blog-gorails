<%= link_to "New Blog Post", new_blog_post_path if user_signed_in? %>
<h1>My Blog</h1>
<%# render each blog post from @blog_posts at the BlogPostsController %>
<% @blog_posts.each do |blog_post| %>
  <div>
    <h2><%= link_to blog_post.title, blog_post_path(blog_post) %></h2>
    <p><%= blog_post.body %></p>
  </div>
<% end %>

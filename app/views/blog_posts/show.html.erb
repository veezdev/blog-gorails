<%= link_to "New Blog Post", new_blog_post_path if user_signed_in? %> </br>
<%= link_to "Edit Post", edit_blog_post_path(@blog_post) if user_signed_in? %>
<h1><%= @blog_post.title %></h1>
<p><%= @blog_post.body %></p>
<%# button for deleting the blog post %>
<%= button_to "Delete Post", @blog_post, method: :delete, form: { data: { turbo_confirm: "Are you sure?" } } %>